<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConsoleEngine.Editor.ViewModels"
        xmlns:models="using:ConsoleEngine.Editor.Models"
        x:Class="ConsoleEngine.Editor.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://ConsoleEngine.Editor/Assets/Icon.png"
        Width="1280" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid RowDefinitions="38,*,26">

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="8,0">

                <!-- Group 1: Project -->
                <Button x:Name="BtnOpen"    Content="📁  Open Project" Padding="8,4" Click="OnOpenProject"/>
                <Button x:Name="BtnNew"     Content="➕  New Scene"    Padding="8,4" Click="OnNewScene"
                        IsEnabled="{Binding HasProject}"/>
                <Button x:Name="BtnSave"    Content="💾  Save"         Padding="8,4" Click="OnSave"
                        IsEnabled="{Binding CanSave}"/>
                <Button x:Name="BtnReload"  Content="🔄  Reload"       Padding="8,4" Click="OnReload"
                        IsEnabled="{Binding CanReload}"
                        ToolTip.Tip="Reload all scene files from disk without closing the editor"/>

                <Rectangle Width="1" Fill="#444" Margin="4,4"/>

                <!-- Group 2: Playback -->
                <Button x:Name="BtnPlay"    Content="▶  Play"          Padding="8,4" Click="OnPlay"
                        IsEnabled="{Binding CanPlay}"
                        ToolTip.Tip="Save and preview the active scene in a real terminal window"/>
                <Button x:Name="BtnStop"    Content="⏹  Stop"          Padding="8,4" Click="OnStop"
                        IsEnabled="{Binding CanStop}"
                        ToolTip.Tip="Terminate the running terminal preview"/>

                <Rectangle Width="1" Fill="#444" Margin="4,4"/>

                <!-- Group 3: Scene operations -->
                <Button x:Name="BtnDuplicate" Content="⧉  Duplicate"   Padding="8,4" Click="OnDuplicate"
                        IsEnabled="{Binding CanDuplicate}"
                        ToolTip.Tip="Copy this scene to a new file"/>
                <Button x:Name="BtnDelete"    Content="🗑  Delete"      Padding="8,4" Click="OnDelete"
                        IsEnabled="{Binding CanDelete}"
                        ToolTip.Tip="Permanently delete this scene file"/>

                <Rectangle Width="1" Fill="#444" Margin="4,4"/>

                <!-- Group 4: Terminal size preset -->
                <TextBlock Text="SIZE" FontSize="10" Foreground="#555"
                           VerticalAlignment="Center" Margin="2,0,4,0"/>
                <ComboBox ItemsSource="{Binding TerminalPresets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                          Width="152" FontSize="11" VerticalAlignment="Center"
                          ToolTip.Tip="Terminal dimensions used in the preview panel"/>

                <Rectangle Width="1" Fill="#444" Margin="4,4"/>

                <!-- Project path breadcrumb -->
                <TextBlock Text="{Binding ProjectPath}" VerticalAlignment="Center"
                           FontSize="11" Opacity="0.55"
                           TextTrimming="PrefixCharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- ── Three-panel body ── -->
        <Grid Grid.Row="1" ColumnDefinitions="220,4,*,4,300">

            <!-- ── Left: scene file list ── -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D2D"
                            BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="SCENES" FontSize="10" FontWeight="Bold"
                                   Foreground="#888" LetterSpacing="2"/>
                    </Border>
                    <ListBox x:Name="SceneList"
                             ItemsSource="{Binding SceneFiles}"
                             SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                             Background="Transparent"
                             SelectionChanged="OnSceneSelected"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SceneFileEntry">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="12"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Padding="10,4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- resize splitter 1 -->
            <GridSplitter Grid.Column="1" Background="#3C3C3C"
                          ResizeDirection="Columns" Width="4"/>

            <!-- ── Centre: terminal simulator ── -->
            <Border Grid.Column="2" Background="#161616">
                <DockPanel>

                    <!-- Panel header: label + live size readout -->
                    <Border DockPanel.Dock="Top" Background="#111111"
                            BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="TERMINAL PREVIEW" FontSize="10" FontWeight="Bold"
                                       Foreground="#888" LetterSpacing="2"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TerminalSizeLabel}"
                                       FontSize="10" Foreground="#555"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable canvas — terminal window is centred inside -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                CornerRadius="5"
                                BorderBrush="#484848"
                                BorderThickness="1"
                                BoxShadow="0 4 24 0 #60000000">

                            <DockPanel>
                                <!-- Terminal title bar with traffic-light dots -->
                                <Border DockPanel.Dock="Top"
                                        Background="#2D2D2D"
                                        CornerRadius="5,5,0,0"
                                        Padding="10,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Traffic lights -->
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="11" Height="11" Fill="#FF5F57"/>
                                            <Ellipse Width="11" Height="11" Fill="#FEBC2E"/>
                                            <Ellipse Width="11" Height="11" Fill="#28C840"/>
                                        </StackPanel>
                                        <!-- Window title -->
                                        <TextBlock Grid.Column="1"
                                                   Text="ConsoleEngine  —  Scene Preview"
                                                   FontSize="11" Foreground="#777"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <!-- Dimensions chip -->
                                        <Border Grid.Column="2"
                                                Background="#1E1E1E"
                                                CornerRadius="3"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding TerminalSizeLabel}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                       Foreground="#555"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Terminal content: text preview + sprite overlay -->
                                <Panel>
                                    <TextBlock x:Name="PreviewBlock"
                                               Text="{Binding PreviewText}"
                                               FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                               FontSize="13"
                                               Foreground="#C8C8C8"
                                               Background="#0C0C0C"
                                               TextWrapping="NoWrap"
                                               Padding="10,8"/>
                                    <!-- Sprite overlay: bottom-right, nearest-neighbour for pixel art crispness -->
                                    <Image Source="{Binding SpriteBitmap}"
                                           IsVisible="{Binding HasSprite}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Stretch="None"
                                           RenderOptions.BitmapInterpolationMode="None"
                                           Margin="0,0,10,28"
                                           ToolTip.Tip="Sprite preview (actual PNG pixels — terminal renders as ▀ half-blocks)"/>
                                </Panel>
                            </DockPanel>
                        </Border>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- resize splitter 2 -->
            <GridSplitter Grid.Column="3" Background="#3C3C3C"
                          ResizeDirection="Columns" Width="4"/>

            <!-- ── Right: properties ── -->
            <Border Grid.Column="4" Background="#252526"
                    BorderBrush="#3C3C3C" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D2D"
                            BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="PROPERTIES" FontSize="10" FontWeight="Bold"
                                   Foreground="#888" LetterSpacing="2"/>
                    </Border>

                    <ScrollViewer IsEnabled="{Binding HasDocument}" Padding="0">
                        <StackPanel Margin="12,10" Spacing="14">

                            <!-- Title -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="TITLE" FontSize="10" Foreground="#888" LetterSpacing="1"/>
                                <TextBox Text="{Binding SceneTitle, Mode=TwoWay}"
                                         FontSize="13" PlaceholderText="Scene title…"/>
                            </StackPanel>

                            <!-- Text Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="TEXT COLOR" FontSize="10" Foreground="#888" LetterSpacing="1"/>
                                <ComboBox SelectedItem="{Binding TextColor, Mode=TwoWay}"
                                          ItemsSource="{Binding AvailableColors}"
                                          HorizontalAlignment="Stretch" FontSize="12"/>
                            </StackPanel>

                            <!-- Art Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="ART COLOR" FontSize="10" Foreground="#888" LetterSpacing="1"/>
                                <ComboBox SelectedItem="{Binding ArtColor, Mode=TwoWay}"
                                          ItemsSource="{Binding AvailableColors}"
                                          HorizontalAlignment="Stretch" FontSize="12"/>
                            </StackPanel>

                            <!-- Continue prompt -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="SHOW CONTINUE PROMPT" FontSize="10" Foreground="#888" LetterSpacing="1"/>
                                <CheckBox IsChecked="{Binding PromptContinue, Mode=TwoWay}"
                                          Content="[ PRESS ENTER TO CONTINUE ]"
                                          FontSize="11"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#3C3C3C"/>

                            <!-- Narration lines -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="NARRATION LINES" FontSize="10" Foreground="#888" LetterSpacing="1"/>
                                <TextBlock Text="One line per row." FontSize="10" Foreground="#555"/>
                                <TextBox Text="{Binding LinesText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         MinHeight="130"
                                         FontFamily="Cascadia Mono,Consolas,monospace"
                                         FontSize="12"
                                         TextWrapping="NoWrap"
                                         PlaceholderText="Write narration lines here…"/>
                            </StackPanel>

                            <!-- ASCII art -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="ASCII ART" FontSize="10" Foreground="#888" LetterSpacing="1"/>
                                <TextBlock Text="One row per line. Use monospace characters." FontSize="10" Foreground="#555"/>
                                <TextBox Text="{Binding AsciiArtText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         MinHeight="110"
                                         FontFamily="Cascadia Mono,Consolas,monospace"
                                         FontSize="12"
                                         TextWrapping="NoWrap"
                                         PlaceholderText="Draw your scene art here…"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#3C3C3C"/>

                            <!-- Sprite (PNG) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="SPRITE  (PNG)" FontSize="10" Foreground="#888" LetterSpacing="1"/>
                                <TextBlock Text="Bottom-anchored, right-aligned in the terminal." FontSize="10" Foreground="#555"/>

                                <!-- Path display + picker + clear -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SpritePath}"
                                               FontSize="11" Foreground="#999"
                                               TextTrimming="LeadingEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding SpritePath}"/>
                                    <Button Grid.Column="1" Content="📂" Padding="6,3" Margin="4,0,0,0"
                                            Click="OnBrowseSprite"
                                            IsEnabled="{Binding HasDocument}"
                                            ToolTip.Tip="Select a PNG file"/>
                                    <Button Grid.Column="2" Content="✕" Padding="6,3" Margin="4,0,0,0"
                                            Click="OnClearSprite"
                                            IsEnabled="{Binding HasSprite}"
                                            ToolTip.Tip="Remove sprite from this scene"/>
                                </Grid>

                                <!-- Computed dims — auto-detected from PNG, editable for override -->
                                <Grid ColumnDefinitions="*,8,*" IsEnabled="{Binding HasSprite}">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="WIDTH (cols)" FontSize="9" Foreground="#666"/>
                                        <TextBox Text="{Binding SpriteWidth, Mode=TwoWay}"
                                                 FontSize="12"
                                                 ToolTip.Tip="Terminal columns (= PNG pixel width)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="ROWS (term. rows)" FontSize="9" Foreground="#666"/>
                                        <TextBox Text="{Binding SpriteRows, Mode=TwoWay}"
                                                 FontSize="12"
                                                 ToolTip.Tip="Terminal rows (= PNG pixel height / 2)"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Thumbnail: pixel-art scaling (nearest-neighbour) -->
                                <Border IsVisible="{Binding HasSprite}"
                                        Background="#0C0C0C"
                                        CornerRadius="3"
                                        BorderBrush="#3C3C3C"
                                        BorderThickness="1"
                                        MaxHeight="128"
                                        Padding="6">
                                    <Image Source="{Binding SpriteBitmap}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="None"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ── Status bar ── -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,0">
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       FontSize="11" Foreground="White"/>
        </Border>

    </Grid>
</Window>
