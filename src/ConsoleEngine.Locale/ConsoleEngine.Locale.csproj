<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ConsoleEngine.Locale</PackageId>
    <AssemblyName>ConsoleEngine.Locale</AssemblyName>
    <RootNamespace>ConsoleEngine.Locale</RootNamespace>
    <Description>Markdown-driven localisation for ConsoleEngine: 11 languages, hot-reload, format args, and key-constant catalogue.</Description>
    <PackageTags>$(PackageTags);localisation;i18n;l10n;markdown</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConsoleEngine.Core\ConsoleEngine.Core.csproj" />
  </ItemGroup>
</Project>
