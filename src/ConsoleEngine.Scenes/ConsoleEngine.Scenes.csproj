<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ConsoleEngine.Scenes</PackageId>
    <AssemblyName>ConsoleEngine.Scenes</AssemblyName>
    <RootNamespace>ConsoleEngine.Scenes</RootNamespace>
    <Description>Scene player, dialogue system, transition effects, and .scene.json loader for ConsoleEngine terminal games.</Description>
    <PackageTags>$(PackageTags);scenes;dialogue;transitions;narrative</PackageTags>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConsoleEngine.Core\ConsoleEngine.Core.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Locale\ConsoleEngine.Locale.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Rendering\ConsoleEngine.Rendering.csproj" />
  </ItemGroup>
</Project>
