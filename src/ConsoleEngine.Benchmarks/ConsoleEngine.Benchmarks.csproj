<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Benchmarks don't ship as a library; suppress doc generation -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1707: BenchmarkDotNet convention requires underscores in method names (e.g. Method_Variant) -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.14.*"
                      Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsoleEngine.Core\ConsoleEngine.Core.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Rendering\ConsoleEngine.Rendering.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Animation\ConsoleEngine.Animation.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Scenes\ConsoleEngine.Scenes.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Locale\ConsoleEngine.Locale.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Persistence\ConsoleEngine.Persistence.csproj" />
    <ProjectReference Include="..\ConsoleEngine.World\ConsoleEngine.World.csproj" />
  </ItemGroup>

</Project>
