<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ConsoleEngine.Rendering</PackageId>
    <AssemblyName>ConsoleEngine.Rendering</AssemblyName>
    <RootNamespace>ConsoleEngine.Rendering</RootNamespace>
    <Description>PNG → ANSI half-block pixel-art renderer and animation engine for ConsoleEngine terminal games.</Description>
    <PackageTags>$(PackageTags);rendering;ansi;pixel-art;animation</PackageTags>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
