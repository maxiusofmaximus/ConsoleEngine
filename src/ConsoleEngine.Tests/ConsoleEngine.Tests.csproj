<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Suppress NuGet packaging metadata since this is a test project. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Suppress CA1707: underscores in test method names are an accepted xUnit convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit"                  Version="2.9.0"  />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsoleEngine.Core\ConsoleEngine.Core.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Locale\ConsoleEngine.Locale.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Scenes\ConsoleEngine.Scenes.csproj" />
    <ProjectReference Include="..\ConsoleEngine.World\ConsoleEngine.World.csproj" />
    <ProjectReference Include="..\ConsoleEngine.Persistence\ConsoleEngine.Persistence.csproj" />
  </ItemGroup>

</Project>
