<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DinoGame</RootNamespace>
    <AssemblyName>DinoGame</AssemblyName>
    <Description>Chrome-Dino-style terminal game — ConsoleEngine v0.2.0 sample.</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ConsoleEngine.Core\ConsoleEngine.Core.csproj" />
    <ProjectReference Include="..\..\src\ConsoleEngine.Locale\ConsoleEngine.Locale.csproj" />
    <ProjectReference Include="..\..\src\ConsoleEngine.Rendering\ConsoleEngine.Rendering.csproj" />
    <ProjectReference Include="..\..\src\ConsoleEngine.Scenes\ConsoleEngine.Scenes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copy locale files next to the executable -->
    <Content Include="GameData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
