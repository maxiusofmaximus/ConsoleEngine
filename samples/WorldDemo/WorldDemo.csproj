<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WorldDemo</RootNamespace>
    <AssemblyName>WorldDemo</AssemblyName>
    <Description>Exploration demo — ConsoleEngine v0.3.0 sample.</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ConsoleEngine.Core\ConsoleEngine.Core.csproj" />
    <ProjectReference Include="..\..\src\ConsoleEngine.Locale\ConsoleEngine.Locale.csproj" />
    <ProjectReference Include="..\..\src\ConsoleEngine.Rendering\ConsoleEngine.Rendering.csproj" />
    <ProjectReference Include="..\..\src\ConsoleEngine.Scenes\ConsoleEngine.Scenes.csproj" />
    <ProjectReference Include="..\..\src\ConsoleEngine.World\ConsoleEngine.World.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="GameData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
